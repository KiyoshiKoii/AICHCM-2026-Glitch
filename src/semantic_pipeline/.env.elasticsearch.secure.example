# Copy this template outside the repository, then pass it with
# `docker compose --env-file <path>`. Never put a password in this file.

# Use an absolute path to a one-line password file with at least 16 characters.
ELASTIC_PASSWORD_SECRET_FILE=C:/Users/your-name/AppData/Local/AICHCM-2026-Glitch/elasticsearch-secure/elastic_password.txt

# The secure stack is isolated from the existing no-auth node on port 9200.
ELASTICSEARCH_SECURE_PORT=19200

# Leaf-certificate lifetime. Rotate it before expiry.
ELASTICSEARCH_CERT_DAYS=365
